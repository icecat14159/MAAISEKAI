    "preset": [
        {
            "name": "全套日常",
            "description": "請注意部分任務需要前置條件",
            "task": [
                {
                    "name": "進入遊戲",
                    "enabled": true
                },
                {
                    "name": "領取評級獎勵",
                    "enabled": true
                },
                {
                    "name": "傑出者祝賀",
                    "enabled": true
                },
                {
                    "name": "排行榜膜拜",
                    "enabled": true
                },
                {
                    "name": "公會事務",
                    "enabled": true
                },
                {
                    "name": "自動遊玩",
                    "enabled": true
                },
                {
                    "name": "礦區清剿",
                    "enabled": true
                },
                {
                    "name": "釣魚事務",
                    "enabled": true
                },
                {
                    "name": "魔法農莊",
                    "enabled": true
                },
                {
                    "name": "魔王挑戰",
                    "enabled": true
                },
                {
                    "name": "其他日常任務",
                    "enabled": true
                },
                {
                    "name": "領取日常獎勵",
                    "enabled": true
                }
            ]
        }
    ]
